GEMINI_API_KEY=
# Local data dir, or the scoring server (e.g. http://localhost:8080)
INBOX_SOURCE=data
CLASSIFY_MODEL=gemini-3.5-flash-lite
EXTRACT_MODEL=gemini-3.5-flash-lite
# Model for scanned PDFs (a transcript for the reviewer); defaults to EXTRACT_MODEL
VISION_MODEL=
MAX_WORKERS=4
MAX_RPM=12

# --- backend (api/): leave empty to use a local SQLite file at output/app.db ---
# Postgres connection string, e.g. from Neon. Set it on Render, never commit it.
DATABASE_URL=
# Website address(es) allowed to call the backend, comma separated. * allows any (fine for local use).
CORS_ORIGINS=*

# --- email simulator (compose an email) and re-run with Gemini ---
SIMULATOR_ENABLED=1
SIM_MAX_PER_HOUR=30
SIM_MAX_STORED=200
RERUN_MAX_PER_HOUR=60

# --- frontend (web/.env.local, or the Vercel project settings) ---
# The backend address, with no trailing slash. Baked in at build time, so redeploy after changing it.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
